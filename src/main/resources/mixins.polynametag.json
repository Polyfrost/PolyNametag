{
	"required": true,
	"compatibilityLevel": "JAVA_21",
	"minVersion": "0.7",
	"package": "org.polyfrost.polynametag.mixin",
	"plugin": "org.polyfrost.polynametag.plugin.PolyNametagMixinPlugin",
	"injectors": {
		"maxShiftBy": 5,
		"defaultRequire": 1
	},
	"client": [
		"client.Mixin_ApplyScaling",
		"client.Mixin_EnableSelfNametag",
		"client.Mixin_FixSneakingNametag",
		"client.Mixin_RemoveNametags",
		"client.Mixin_RemoveNametagsAvatar",
		"client.Mixin_RemoveNametagsLiving",
		"client.Mixin_ShowInInventory"
	],
	"verbose": true
}
